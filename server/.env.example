PORT=3003
HOST=127.0.0.1
FRONTEND_PORT=3002
FRONTEND_HOST=127.0.0.1
# Explicit local test wallet + automatic CCIP service, disabled in normal startup.
# Bind local signing services to loopback.
HEDGE_LOCAL_TESTNET=0
# Platform-owned persistence: mongodb or postgres. none is for health/local testnet only.
DATABASE_DRIVER=none
DATABASE_URL=
# MongoDB example: mongodb://127.0.0.1:27017/hedge
# PostgreSQL example: postgresql://hedge:password@127.0.0.1:5432/hedge
# Redis/BullMQ is optional; the selected database provides the durable outbox fallback.
REDIS_URL=
REDIS_PREFIX=hedge
# Comma-separated explicit frontend origins. Leave empty for same-origin/server-to-server use.
CORS_ORIGINS=
# Single verified deployment record; startup never deploys contracts.
HEDGE_OPERATOR_MAX_FEE_HBAR=2
HEDGE_OPERATOR_MIN_HBAR=5
# Backend loan terms and borrower allowlist; applied to newly published offers.
